    "row":      { "value": "14px",   "comment": "Content rows (original)" },
    "card":     { "value": "16px",   "comment": "Feature cards, genre bars, glass rows" },
    "card-lg":  { "value": "18px",   "comment": "Dark-glass value card" },
    "shell":    { "value": "44px",   "comment": "Phone shell outer radius" },
    "pill":     { "value": "9999px", "comment": "Buttons, badges, home bar, glow blobs" }
