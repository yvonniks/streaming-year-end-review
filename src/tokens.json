  "effect": {
    "blur": {
      "small":  { "value": "2px",  "comment": "Ghost year text blur" },
      "row":    { "value": "16px", "comment": "Glass row backdrop-filter" },
      "card":   { "value": "20px", "comment": "Glass card / value card backdrop-filter" },
      "glow-sm":{ "value": "30px", "comment": "Small glow blobs (Shop screen)" },
      "glow":   { "value": "40px", "comment": "Standard glow blobs" },
      "glow-lg":{ "value": "56px", "comment": "Large ambient glows" },
      "glow-xl":{ "value": "80px", "comment": "Premium blue glow blob" }
    },
    "border": {
      "glass-card": { "value": "1px solid rgba(255,255,255,0.13)" },
